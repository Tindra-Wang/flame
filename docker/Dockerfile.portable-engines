FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get -o Acquire::Retries=3 update \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends xz-utils \
 && rm -rf /var/lib/apt/lists/*
COPY scripts/download-assets.py /app/scripts/download-assets.py
RUN --mount=type=cache,id=ai07-public-engine-downloads,target=/app/engines/downloads,sharing=locked \
    python /app/scripts/download-assets.py --only fds \
 && mkdir -p /opt/fds \
 && line=$(awk '/^__TARFILE_FOLLOWS__/{print NR+1;exit}' /app/engines/downloads/fds.sh) \
 && tail -n +${line} /app/engines/downloads/fds.sh | tar -xz --strip-components=1 -C /opt/fds
RUN --mount=type=cache,id=ai07-public-engine-downloads,target=/app/engines/downloads,sharing=locked \
    python /app/scripts/download-assets.py --only blender \
 && mkdir -p /opt/blender \
 && tar -xJf /app/engines/downloads/blender.tar.xz --strip-components=1 -C /opt/blender
