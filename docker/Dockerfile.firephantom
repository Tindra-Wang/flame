# Reuse the project's tested Linux Blender runtime (fcntl is not available on Windows).
FROM ai07-modeling:blender
WORKDIR /app
RUN apt-get -o Acquire::Retries=3 update \
 && apt-get -o Acquire::Retries=3 install -y --no-install-recommends ffmpeg git libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
COPY integrations/firephantom/requirements.txt /tmp/firephantom-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r /tmp/firephantom-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install python-multipart==0.0.32
COPY integrations/firephantom/firephantom /app/firephantom
COPY integrations/firephantom/web/dist /app/web/dist
COPY docker/firephantom_entry.py /app/firephantom_entry.py
ENV PYTHONUNBUFFERED=1 DATASET_ROOT=/data FIREPHANTOM_SESSION_SECRET_FILE=/data/session.secret \
    BLENDER_BIN=/usr/local/bin/blender FIREPHANTOM_JOB_WORKERS=1 OMP_NUM_THREADS=2 DVC_NO_ANALYTICS=1
EXPOSE 8765
ENTRYPOINT ["python", "-m", "uvicorn", "firephantom_entry:app", "--host", "0.0.0.0", "--port", "8765"]
