FROM postgres:16-bookworm@sha256:537d0998e20878d435e5f4bd2f672dc5400a2f832ee3b9c0625f71437d2bde43 AS pgtools
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DVC_NO_ANALYTICS=1 AI07_ROOT=/app
WORKDIR /app
RUN --mount=type=cache,target=/var/cache/apt --mount=type=cache,target=/var/lib/apt/lists \
    apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends git postgresql-client
COPY --from=pgtools /usr/lib/postgresql/16/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=pgtools /usr/lib/postgresql/16/bin/pg_restore /usr/local/bin/pg_restore
COPY docker/requirements-platform.in /app/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
COPY platform_api /app/platform_api
COPY fire_modeling /app/fire_modeling
COPY integrations/firephantom/firephantom /app/integrations/firephantom/firephantom
COPY configs /app/configs
COPY docs /app/docs
COPY SRS.md /app/SRS.md
COPY scripts/portable-backup.py /app/scripts/portable-backup.py
CMD ["uvicorn","platform_api.app:app","--host","0.0.0.0","--port","8090"]
