<mxfile host="app.diagrams.net" type="device" version="31.4.5"><diagram name="01_总体框架" id="AI07-page-01">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1848" pageHeight="1120" math="1" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="AI-07 完整功能框架" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=28;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="24" width="1720" height="48" as="geometry" /></mxCell><mxCell id="3" value="指定技术栈全部保留；绿色为已有部分能力，蓝/橙为待完善设计；本图不代表平台已建成" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="80" width="1720" height="48" as="geometry" /></mxCell><mxCell id="4" value="价值：减少危险采集与重复标注&lt;br&gt;增加场景多样性；保留真实评价证据" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="152" width="1712" height="80" as="geometry" /></mxCell><mxCell id="5" value="统一 Web 可视化平台（待实现）&lt;br&gt;场景配置 / 任务日志 / 原图增强对比 / 标注质检 / DVC版本 / 评价监控" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="280" width="1712" height="96" as="geometry" /></mxCell><mxCell id="6" value="FastAPI 模块化应用：身份与项目隔离、任务编排、审核门禁、发布事务、可追溯性" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="424" width="1712" height="72" as="geometry" /></mxCell><mxCell id="7" value="FDS&lt;br&gt;CFD＋燃烧模型&lt;br&gt;物理量、日志、工况" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="560" width="248" height="136" as="geometry" /></mxCell><mxCell id="8" value="Blender&lt;br&gt;多场景/视角/能见度&lt;br&gt;RGB＋候选掩膜" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="336" y="560" width="248" height="136" as="geometry" /></mxCell><mxCell id="9" value="Stable Diffusion&lt;br&gt;预训练 img2img&lt;br&gt;种子/模型哈希/父图" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="624" y="560" width="248" height="136" as="geometry" /></mxCell><mxCell id="10" value="Label Studio&lt;br&gt;候选标注＋人工修订&lt;br&gt;审核绑定图像/修订" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="912" y="560" width="248" height="136" as="geometry" /></mxCell><mxCell id="11" value="质量筛选&lt;br&gt;完整性/重复/框合法性&lt;br&gt;视觉人工评价" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="560" width="248" height="136" as="geometry" /></mxCell><mxCell id="12" value="DVC＋Git&lt;br&gt;冻结清单与版本差异&lt;br&gt;COCO/YOLO导出" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1488" y="560" width="248" height="136" as="geometry" /></mxCell><mxCell id="13" value="验收证据：真实/合成 FID；相同预算下 YOLO 两组对照；物理量与独立参照误差&lt;br&gt;现有样例只证明部分链路可运行，不能证明 5%物理误差或15%检测提升" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="768" width="1712" height="104" as="geometry" /></mxCell><mxCell id="14" value="工程实践贯穿全链路：规范化数据管道 / 人工真值 / 同源分组 / 幂等与取消 / 镜像与模型固定&lt;br&gt;统一交付：SRS、SDD、测试、OpenAPI、Git Flow、SonarQube、Compose、CI/CD、监控、云Demo、PPT/视频、合规材料" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F1F3F5;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="920" width="1712" height="112" as="geometry" /></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWid