<diagram name="02_系统架构" id="AI07-page-02">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1848" pageHeight="1168" math="1" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="AI-07 低耦合系统架构（目标态）" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=28;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="24" width="1720" height="48" as="geometry" /></mxCell><mxCell id="3" value="低成本取舍：一个模块化API＋少量Worker；PG复用为队列，不新增Redis/Celery/K8s" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="80" width="1720" height="48" as="geometry" /></mxCell><mxCell id="4" value="浏览器：Vue3＋TypeScript&lt;br&gt;场景/任务/对比/审核/版本/评价&lt;br&gt;单一项目权限上下文" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="160" width="376" height="128" as="geometry" /></mxCell><mxCell id="5" value="Nginx TLS → FastAPI 模块化应用&lt;br&gt;Auth / Projects / Jobs / Samples&lt;br&gt;Review / Versions / Experiments&lt;br&gt;OpenAPI + /metrics" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="160" width="576" height="144" as="geometry" /></mxCell><mxCell id="6" value="本机或按需 GPU Worker&lt;br&gt;主动 HTTPS 拉取任务&lt;br&gt;lease / heartbeat / timeout&lt;br&gt;只通过内部API回传业务状态" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="408" width="432" height="144" as="geometry" /></mxCell><mxCell id="7" value="PostgreSQL&lt;br&gt;项目元数据＋持久任务队列&lt;br&gt;事务 claim / SKIP LOCKED&lt;br&gt;单写入边界：平台应用" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="440" width="376" height="144" as="geometry" /></mxCell><mxCell id="8" value="Label Studio（内部服务）&lt;br&gt;API 同步真实任务与标签&lt;br&gt;平台框编辑 → 受限代理API&lt;br&gt;不共享管理员令牌给浏览器" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="440" width="576" height="144" as="geometry" /></mxCell><mxCell id="9" value="Artifact StoragePort&lt;br&gt;本地文件卷＋云端已审核产物&lt;br&gt;鉴权上传/下载、SHA256、配额&lt;br&gt;后续可换 S3，业务不依赖路径" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="736" width="376" height="144" as="geometry" /></mxCell><mxCell id="10" value="DVC / Git Adapter&lt;br&gt;准备快照 → DVC提交/备份&lt;br&gt;核验成功后标记已发布&lt;br&gt;失败保持不可见，可对账恢复" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="736" width="576" height="144" as="geometry" /></mxCell><mxCell id="11" value="隔离引擎与算法适配器&lt;br&gt;FDS → Blender → SD&lt;br&gt;质检 / COCO-YOLO / FID / 检测&lt;br&gt;CPU与GPU并发配额独立" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="736" width="432" height="144" as="geometry" /></mxCell><mxCell id="12" value="工程与运维接口：GitHub Actions → 测试≥70% → SonarQube门禁 → 镜像构建/灰度/回滚&lt;br&gt;Prometheus＋Grafana告警；Sonar按需运行；独立备份/恢复；成本计量事件；云端CPU Demo接入在线Worker" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F1F3F5;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="976" width="1664" height="112" as="geometry" /></mxCell><mxCell id="13" value="本地/临租计算区" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="1280" y="336" width="432" height="48" as="geometry" /></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4444;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="15" value="HTTPS" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#64748B;fontFamily=Microsoft YaHei;" vertex="1" connectable="0" parent="14"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=0;exitY=0.65;entryX=1;entryY=0.5;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="254" /><mxPoint x="480" y="512" /></Array></mxGeometry></mxCell><mxCell id="17" value="事务" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#64748B;fontFamily=Microsoft YaHei;" vertex="1" connectable="0" parent="16"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="19" value="受限服务账号" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#64748B;fontFamily=Microsoft YaHei;" vertex="1" connectable="0" parent="18"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;endFill=0;endSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="7" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="21" value="元数据引用" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#64748B;fontFamily=Microsoft YaHei;" vertex="1" connectable="0" parent="20"><mxGeometry x="0.5" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;endArrow=open;