    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3136" pageHeight="1816" math="1" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="PERT 任务成本网络（五人固定角色）" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=28;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="24" width="3008" height="48" as="geometry" /></mxCell><mxCell id="3" value="与工期图使用相同圆形节点和依赖；节点成本=指定人员实际人时×单价＋归属现金＋硬件摊销；红色为逻辑关键路径" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="80" width="3008" height="48" as="geometry" /></mxCell><mxCell id="4" value="A 需求、数据授权与参照可用性&lt;br&gt;PM/QA  18人时&lt;br&gt;人工：Σ角色人时×角色单价&lt;br&gt;资源：用量×待定单价&lt;br&gt;D=3 资源[0,3)" style="ellipse;html=1;whiteSpace=wrap;fillColor=#FCEBEB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="480" width="256" height="256" as="geometry" /></mxCell><mxCell id="5" value="B 架构、ER与API契约&lt;br&gt;AR  12人时&lt;br&gt;人工：Σ角色人时×角色单价&lt;br&gt;资源：用量×待定单价&lt;br&gt;D=4 资源[3,7)" style="ellipse;html=1;whiteSpace=wrap;fillColor=#FCEBEB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=14;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="352" y="480" width="256" height="256" as="geometry" /></mxCell><mxCell id="6" value="C 测试/CI/Sonar骨架&lt;br&gt;QA/OPS  24人时&lt;br&gt;人工：Σ角色人时×角色单价&lt;br&gt;资源：用量×待定单价&lt;br&gt;D=4 资源[7,11)" style="ellipse;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E29