<diagram name="04_UML类图" id="AI07-page-04">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1848" pageHeight="1136" math="1" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="UML 设计类图与端口边界" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=28;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="24" width="1720" height="48" as="geometry" /></mxCell><mxCell id="3" value="类图表示目标设计接口；现有 Renderer、文件契约和算法函数可适配复用" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1E293B;fontSize=18;fontFamily=Microsoft YaHei;align=left;verticalAlign=top" vertex="1" parent="1"><mxGeometry x="48" y="80" width="1720" height="48" as="geometry" /></mxCell><mxCell id="4" value="ApplicationService&lt;br&gt;────────────&lt;br&gt;submitJob / reviewSample&lt;br&gt;publishVersion / runExperiment" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="176" width="328" height="168" as="geometry" /></mxCell><mxCell id="5" value="JobOrchestrator&lt;br&gt;────────────&lt;br&gt;claimLease / heartbeat&lt;br&gt;retry / cancel / checkpoint" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="176" width="328" height="168" as="geometry" /></mxCell><mxCell id="6" value="«interface» EnginePort&lt;br&gt;────────────&lt;br&gt;prepare(config)&lt;br&gt;execute(context) → StageResult" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="176" width="328" height="168" as="geometry" /></mxCell><mxCell id="7" value="FdsAdapter / BlenderAdapter&lt;br&gt;────────────&lt;br&gt;参数校验 / 子进程超时&lt;br&gt;文件清单与物理代理说明" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1296" y="176" width="328" height="168" as="geometry" /></mxCell><mxCell id="8" value="ReviewService&lt;br&gt;────────────&lt;br&gt;imageSHA + annotationRevision&lt;br&gt;人工修订 / 冲突检测" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="464" width="328" height="168" as="geometry" /></mxCell><mxCell id="9" value="«interface» LabelPort&lt;br&gt;────────────&lt;br&gt;createTask / importRevision&lt;br&gt;Webhook去重/项目校验" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="464" width="328" height="168" as="geometry" /></mxCell><mxCell id="10" value="VersionService&lt;br&gt;────────────&lt;br&gt;冻结审核标签与分组&lt;br&gt;prepare / commit / publish" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="464" width="328" height="168" as="geometry" /></mxCell><mxCell id="11" value="«interface» VersionPort&lt;br&gt;────────────&lt;br&gt;DvcAdapter.prepare/push/verify&lt;br&gt;Git SHA＋manifest SHA" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1296" y="464" width="328" height="168" as="geometry" /></mxCell><mxCell id="12" value="«interface» StoragePort&lt;br&gt;────────────&lt;br&gt;put / get / signedDownload&lt;br&gt;LocalVolume → SSH/S3" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="48" y="752" width="328" height="168" as="geometry" /></mxCell><mxCell id="13" value="Repository / UnitOfWork&lt;br&gt;────────────&lt;br&gt;项目隔离 / 乐观锁&lt;br&gt;PG事务 / Outbox" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF2DB;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="752" width="328" height="168" as="geometry" /></mxCell><mxCell id="14" value="EvaluationService&lt;br&gt;────────────&lt;br&gt;FID / 物理误差 / YOLO对照&lt;br&gt;版本、预算与参照快照" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EAF2FC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="752" width="328" height="168" as="geometry" /></mxCell><mxCell id="15" value="Diffusion / Detection Adapter&lt;br&gt;────────────&lt;br&gt;SD1.5 / YOLO11n&lt;br&gt;模型哈希、种子与真实结果" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#E9F4EE;strokeColor=#64748B;strokeWidth=1.5;fontColor=#1E293B;fontSize=16;fontFamily=Microsoft YaHei;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1296" y="752" width="328" height="168" as="geometry" /></mxCell><mxCell